{
  "name": "job-application-agent",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web build",
    "build:worker": "pnpm --filter worker build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter db run db:generate",
    "db:migrate": "pnpm --filter db run db:migrate",
    "db:push": "pnpm --filter db run db:push",
    "db:studio": "pnpm --filter db run db:studio",
    "db:seed": "pnpm --filter db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.19.12"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
