# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Google Gemini AI (used for job analysis, resume parsing, and AI features)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_STORAGE_DIR=.playwright

# Cron/Worker
CRON_SECRET=your_cron_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Email Ingestion (IMAP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your_email@gmail.com
EMAIL_IMAP_PASSWORD=your_app_password

# Resume Import (place your .md/.txt/.pdf resumes in apps/resumes/ folder)
# The app will auto-detect resumes in apps/resumes/ and allow import via Profile tab

# Node Environment
NODE_ENV=development